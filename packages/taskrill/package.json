{
  "name": "taskrill",
  "version": "0.2.0-beta.0",
  "type": "module",
  "description": "Lightweight in-process scheduler for event-driven task graphs.",
  "main": "src/index.ts",
  "files": [
    "lib"
  ],
  "author": {
    "name": "unbyte",
    "url": "https://github.com/unbyte"
  },
  "license": "MIT",
  "homepage": "https://github.com/unbyte/taskrill/tree/main/packages/taskrill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbyte/taskrill.git",
    "directory": "packages/taskrill"
  },
  "bugs": {
    "url": "https://github.com/unbyte/taskrill/issues"
  },
  "keywords": [
    "task",
    "runtime",
    "scheduler",
    "concurrency",
    "pipeline",
    "async",
    "fan-out",
    "in-process",
    "abort",
    "cancellation"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "lib/index.cjs",
    "module": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js",
        "require": "./lib/index.cjs"
      }
    }
  }
}
